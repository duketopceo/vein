# Model access — extraction, classification, synthesis, verification.
# A model response is never evidence; it produces candidate claims only.
OPENROUTER_API_KEY=

# Web-grounded discovery (Perplexity Sonar). Preferred: direct API.
# OpenRouter route (perplexity/sonar) allowed only after U6 verifies it
# preserves the response fields and citations VEIN requires.
SONAR_API_KEY=
# SONAR_VIA_OPENROUTER=false

# last30days adapter — community discussion is discovery, not audited fact.
# Path to the last30days CLI/scripts (mvanhorn/last30days-skill).
LAST30DAYS_BIN=

# Local data roots (defaults shown; override for tests)
# VEIN_DATA_DIR=~/.local/share/vein
# VEIN_ARTIFACT_DIR=~/.local/share/vein/artifacts
